<IfModule mod_headers.c>
<FilesMatch "\.(html|json)$|service-worker\.js$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
</FilesMatch>
<FilesMatch "\.(js|css|webp|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#/_app/immutable/#"
</FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Se il file o la directory fisica richiesta esistono, servili direttamente
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Altrimenti riscrivi tutto su index.html (SPA fallback)
    RewriteRule ^ index.html [L]
</IfModule>